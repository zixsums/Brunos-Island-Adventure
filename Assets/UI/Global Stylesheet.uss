.primary-container {
    background-color: rgb(241, 233, 226);
    border-left-color: rgb(60, 147, 180);
    border-right-color: rgb(60, 147, 180);
    border-top-color: rgb(60, 147, 180);
    border-bottom-color: rgb(60, 147, 180);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-top: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    padding-left: 40px;
}

.base-text {
    -unity-font-style: italic;
    white-space: normal;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font: url("project://database/Assets/Game%20Assets/Fonts/OdibeeSans-Regular.ttf?fileID=12800000&guid=94c91e133c0f88c438ef55128a1cd703&type=3#OdibeeSans-Regular");
    -unity-font-definition: initial;
}

.center {
    align-items: center;
    justify-content: center;
    height: 100%;
}

.menu-button {
    width: 325px;
    padding-top: 20px;
    padding-bottom: 20px;
    -unity-font: url("project://database/Assets/Game%20Assets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&guid=54e211dc271629f498472679fc996b48&type=3#PressStart2P-Regular");
    -unity-font-style: italic;
    -unity-font-definition: initial;
    font-size: 32px;
    color: rgb(250, 250, 250);
    -unity-text-align: upper-center;
    background-color: rgb(41, 153, 201);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.active {
    background-color: rgb(169, 206, 48);
}

.stat-container {
    background-color: rgb(0, 0, 0);
    font-size: 2px;
    -unity-text-align: upper-left;
    color: rgb(253, 253, 253);
    flex-direction: row;
    height: 49px;
    width: 322px;
    margin-right: 20px;
}

.stat-name {
    background-color: rgb(17, 223, 46);
    -unity-font: url("project://database/Assets/Game%20Assets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&guid=54e211dc271629f498472679fc996b48&type=3#PressStart2P-Regular");
    font-size: 30px;
    -unity-font-style: bold;
    -unity-font-definition: initial;
    -unity-text-align: upper-center;
    color: rgb(255, 251, 251);
    width: 210px;
    height: 51px;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.stat-value {
    font-size: 30px;
    -unity-text-align: upper-center;
    -unity-font: url("project://database/Assets/Game%20Assets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&guid=54e211dc271629f498472679fc996b48&type=3#PressStart2P-Regular");
    -unity-font-definition: initial;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}
